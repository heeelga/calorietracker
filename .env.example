# Docker Compose / server environment
# Copy to .env and adjust values before starting

# MariaDB root password (only used by the db container)
DB_ROOT_PASSWORD=changeme-root

# Database connection
DB_HOST=db
DB_PORT=3306
DB_USER=calorietracker
DB_PASSWORD=changeme-db
DB_NAME=calorietracker

# JWT signing secret — use a long random string
JWT_SECRET=change-this-to-a-random-secret-min-32-chars

# Port exposed on the host
PORT=3002

# Set to "true" to allow automatic login via Traefik mTLS certificate CN
# The CN format "device-username" is matched against user names/emails
MTLS_ENABLED=false
